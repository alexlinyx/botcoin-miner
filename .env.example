# Bankr API key (required for wallet operations)
BANKR_API_KEY=your_bankr_api_key_here

# Venice AI API key for solving challenges
VENICE_API_KEY=your_venice_api_key_here

# Venice AI model (default: qwen3-235b-a22b-instruct-2507 - fast & capable)
# Recommended for BOTCOIN (ranked by speed/reliability):
#   - qwen3-235b-a22b-instruct-2507 (fast, capable, $0.15/$0.75) ⭐ RECOMMENDED
#   - zai-org-glm-4.7 (fast reasoning, $0.55/$2.65)
#   - qwen3-235b-a22b-thinking-2507 (slow reasoning, $0.45/$3.50)
#   - zai-org-glm-5 (slow frontier, $1.00/$3.20)
#   - deepseek-v3.2 (verbose, $0.40/$1.00)
VENICE_MODEL=qwen3-235b-a22b-instruct-2507

# Max tokens for LLM response (default: 16000)
MAX_TOKENS=16000

# LLM API timeout in seconds (default: 420 = 7 minutes)
# Increase if getting timeouts, decrease for faster failures
LLM_TIMEOUT=420

# Venice AI base URL (default: https://api.venice.ai/api/v1)
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Self-correction: max retries per challenge before getting new one (default: 3)
MAX_RETRIES=3

# Coordinator URL (default: https://coordinator.agentmoney.net)
COORDINATOR_URL=https://coordinator.agentmoney.net
