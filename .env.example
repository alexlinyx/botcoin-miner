# Bankr API key (required for wallet operations)
BANKR_API_KEY=your_bankr_api_key_here

# Venice AI API key for solving challenges
VENICE_API_KEY=your_venice_api_key_here

# ============================================
# MODEL CONFIGURATION
# ============================================

# Model for solving challenges
MODEL=qwen3-235b-a22b-thinking-2507

# ============================================
# API SETTINGS
# ============================================

# Venice AI base URL
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Coordinator URL
COORDINATOR_URL=https://coordinator.agentmoney.net

# Max tokens for LLM response (0 = unlimited)
MAX_TOKENS=0

# LLM API timeout in seconds (0 = no timeout)
LLM_TIMEOUT=0
