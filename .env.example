# Bankr API key (required for wallet operations)
BANKR_API_KEY=your_bankr_api_key_here

# Venice AI API key for solving challenges
VENICE_API_KEY=your_venice_api_key_here

# Venice AI model
VENICE_MODEL=zai-org-glm-5

# Max tokens for LLM response (0 = unlimited, but Venice has per-model limits)
MAX_TOKENS=16000

# Concurrent agent swarm mode (true = parallel, false = sequential)
# Parallel is faster but uses more resources
CONCURRENT_SWARM=false

# Self-correction: max retries per question (default: 3)
MAX_RETRIES=3

# Venice AI base URL
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Coordinator URL
COORDINATOR_URL=https://coordinator.agentmoney.net
