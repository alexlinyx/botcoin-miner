# Bankr API key (required for wallet operations)
BANKR_API_KEY=your_bankr_api_key_here

# OpenAI API key for solving challenges
LLM_API_KEY=your_openai_api_key_here

# LLM model to use (default: gpt-4o)
LLM_MODEL=gpt-4o

# Coordinator URL (default: https://coordinator.agentmoney.net)
COORDINATOR_URL=https://coordinator.agentmoney.net
