# Bankr API key (required for wallet operations)
BANKR_API_KEY=your_bankr_api_key_here

# Venice AI API key
VENICE_API_KEY=your_venice_api_key_here

# ============================================
# MODEL CONFIGURATION PER ROLE
# ============================================

# Main orchestrator - coordinates everything, constructs artifact
# Recommended: zai-org-glm-5 (best overall), anthropic/claude-3.5-sonnet (if available)
ORCHESTRATOR_MODEL=zai-org-glm-5

# Question answerer - solves individual questions
# Can use same as orchestrator, or a faster/cheaper model
# If not set, defaults to ORCHESTRATOR_MODEL
ANSWER_SOLVER_MODEL=zai-org-glm-5

# Answer checker - verifies answers are correct
# Can use same as orchestrator, or a more thorough model
# If not set, defaults to ORCHESTRATOR_MODEL
ANSWER_CHECKER_MODEL=zai-org-glm-5

# ============================================
# MODE SELECTION
# ============================================

# true = Efficient 2-phase mode (faster, fewer tokens)
# false = Multi-agent mode (more thorough, more tokens)
USE_EFFICIENT_MODE=true

# ============================================
# MULTI-AGENT SETTINGS (only used if USE_EFFICIENT_MODE=false)
# ============================================

# Number of concurrent question-answer pairs
# 1 = Sequential (safest)
# 3-5 = Parallel (faster)
CONCURRENT_SWARM=1

# Max retries per question before accepting best guess
MAX_RETRIES=3

# ============================================
# TOKEN SETTINGS
# ============================================

# Max tokens per API call for generic helpers (0 = use default)
MAX_TOKENS=32000

# Phase-specific caps for 2-phase / efficient solvers
# Phase 1: answer-all-questions JSON call
PHASE1_MAX_TOKENS=8000
# Phase 2: artifact-construction call
PHASE2_MAX_TOKENS=4000

# ============================================
# API SETTINGS
# ============================================

VENICE_BASE_URL=https://api.venice.ai/api/v1
COORDINATOR_URL=https://coordinator.agentmoney.net
