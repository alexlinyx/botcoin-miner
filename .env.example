# Bankr API key (required for wallet operations)
BANKR_API_KEY=your_bankr_api_key_here

# Venice AI API key for solving challenges
VENICE_API_KEY=your_venice_api_key_here

# Venice AI model (default: qwen3-235b-a22b-thinking-2507 - best reasoning model)
# Recommended for BOTCOIN:
#   - qwen3-235b-a22b-thinking-2507 (best reasoning, $0.45/$3.50)
#   - zai-org-glm-5 (frontier reasoning, $1.00/$3.20)
#   - kimi-k2-thinking (long context, $0.75/$3.20)
#   - deepseek-v3.2 (budget option, $0.40/$1.00 but verbose)
VENICE_MODEL=qwen3-235b-a22b-thinking-2507

# Max tokens for LLM response (default: 16000)
# Increase to 24000 if model gets cut off mid-reasoning
MAX_TOKENS=16000

# Venice AI base URL (default: https://api.venice.ai/api/v1)
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Self-correction: max retries per challenge before getting new one (default: 3)
MAX_RETRIES=3

# Coordinator URL (default: https://coordinator.agentmoney.net)
COORDINATOR_URL=https://coordinator.agentmoney.net
